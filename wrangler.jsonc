// Cloudflare Workers deployment (free plan): the built game (dist/) as static
// assets, plus the online API and one Durable Object per room.
{
  "name": "warzil",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  // Official address (Cloudflare Custom Domain on the warzil.com.br zone); the
  // workers.dev address keeps working alongside it.
  "workers_dev": true,
  "routes": [{ "pattern": "warzil.com.br", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "METRICS", "class_name": "Metrics" }
    ]
  },
  // Free plan: SQLite-backed Durable Objects. v2 adds the usage counters.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject", "Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Metrics"] }
  ],
  // Staging (npm run deploy:preview): a separate Worker, warzil-preview, with its
  // own Durable Objects and storage; it never shares rooms or data with production.
  "env": {
    "preview": {
      "name": "warzil-preview",
      // Staging stays on workers.dev only (routes would otherwise be inherited).
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "durable_objects": {
        "bindings": [
          { "name": "ROOMS", "class_name": "RoomObject" },
          { "name": "LIMITER", "class_name": "Limiter" },
          { "name": "METRICS", "class_name": "Metrics" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["RoomObject", "Limiter"] },
        { "tag": "v2", "new_sqlite_classes": ["Metrics"] }
      ]
    }
  }
}
